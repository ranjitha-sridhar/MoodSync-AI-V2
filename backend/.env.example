# MoodSync AI Backend Environment Configuration

PROJECT_NAME="MoodSync AI"
VERSION="2.0.0"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: Leave empty or use SQLite for local development.
# For production PostgreSQL (Supabase / Render / Neon), set:
# DATABASE_URL="postgresql://user:password@host:port/database"
DATABASE_URL="sqlite:///./moodsync.db"

# Optional Spotify API integration (if configured)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
